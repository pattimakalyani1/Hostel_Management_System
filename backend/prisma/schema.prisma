generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  WARDEN
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AllocationStatus {
  ACTIVE
  VACATED
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum ComplaintCategory {
  WATER
  ELECTRICITY
  FAN_AC
  CLEANING
  WIFI
  FOOD
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum OutpassStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  OVERDUE
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  role        Role
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student?
  approvedOutpasses Outpass[] @relation("ApprovedBy")
  notifications Notification[]
}

model Student {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  name        String
  phone       String?
  course      String?
  year        Int?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  allocations Allocation[]
  fees        Fee[]
  payments    Payment[]
  complaints  Complaint[]
  outpasses   Outpass[]
}

model Room {
  id           Int      @id @default(autoincrement())
  roomNumber   String   @unique
  floor        Int
  capacity     Int
  sharingType  Int      @default(4)   // 1 | 2 | 3 | 4
  roomType     String?
  description  String?
  status       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  beds         Bed[]
  allocations  Allocation[]
}

model Bed {
  id                 Int       @id @default(autoincrement())
  roomId             Int
  bedNumber          String
  status             BedStatus @default(AVAILABLE)
  maintenanceReason  String?
  maintenanceDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  room        Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@unique([roomId, bedNumber])
}

model Allocation {
  id            Int              @id @default(autoincrement())
  studentId     Int
  roomId        Int
  bedId         Int
  allocatedDate DateTime         @default(now())
  vacatedDate   DateTime?
  status        AllocationStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room          Room    @relation(fields: [roomId], references: [id])
  bed           Bed     @relation(fields: [bedId], references: [id])
}

model Fee {
  id          Int       @id @default(autoincrement())
  studentId   Int
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  description String?
  status      FeeStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments    Payment[]
}

model Payment {
  id            Int            @id @default(autoincrement())
  studentId    Int
  feeId         Int
  amount        Decimal        @db.Decimal(10, 2)
  paymentDate   DateTime       @default(now())
  paymentMethod PaymentMethod
  transactionId String?        @unique
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())

  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee           Fee     @relation(fields: [feeId], references: [id])
}

model Complaint {
  id             Int               @id @default(autoincrement())
  studentId      Int
  title          String
  description    String
  category       ComplaintCategory
  status         ComplaintStatus   @default(OPEN)
  wardenResponse String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resolvedAt     DateTime?

  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Outpass {
  id                  Int           @id @default(autoincrement())
  studentId           Int
  outDate             DateTime
  leavingTime         DateTime
  expectedReturnTime  DateTime
  actualReturnTime    DateTime?
  destination         String
  reason              String
  emergencyContact    String?
  status              OutpassStatus @default(PENDING)
  wardenComment       String?
  approvedBy          Int?
  createdAt           DateTime      @default(now())
  approvedAt          DateTime?

  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  warden              User?   @relation("ApprovedBy", fields: [approvedBy], references: [id])
}

enum NotificationType {
  ROOM
  FEE
  PAYMENT
  COMPLAINT
  OUTPASS
  GENERAL
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
