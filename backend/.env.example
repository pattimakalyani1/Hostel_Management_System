# Server Configuration
PORT=5000

# CORS: comma-separated list of allowed frontend origins.
# localhost:5173 is always allowed for local dev; add deployed URLs here.
# Example: CORS_ORIGIN="https://your-app.vercel.app,https://www.your-domain.com"
CORS_ORIGIN="http://localhost:5173"

# Database Configuration (Supabase PostgreSQL)
# Pooler connection (port 6543, for application queries via Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432, for Prisma migrations/introspection)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET="your_secure_jwt_secret_change_this_in_production"
JWT_EXPIRES_IN="1d"

# Default Admin/Warden Account
ADMIN_EMAIL="admin@hostel.com"
ADMIN_PASSWORD="change_this_password"

# Password Reset Token Expiry (in minutes)
RESET_TOKEN_EXPIRY=30

# ─────────────────────────────────────────────────────────────
# Deployment notes (Render)
# ─────────────────────────────────────────────────────────────
# This repo is a monorepo: backend/ and frontend/ each have their own
# package.json and there is NO package.json at the repo root. A default
# Render deploy therefore fails with:
#   ENOENT ... open '/opt/render/project/src/package.json'
#
# Configure the Render Web Service like this (or use the root render.yaml):
#   Root Directory : backend
#   Build Command  : npm install && npx prisma generate
#   Start Command  : npm start
#   Health Check   : /api/health
#
# Environment variables on Render:
#   - Set DATABASE_URL, DIRECT_URL, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
#     in the Render dashboard (Environment tab) — never commit real secrets.
#   - JWT_EXPIRES_IN=1d and RESET_TOKEN_EXPIRY=30 can be set as plain values.
#   - Do NOT set PORT — Render assigns it and server.js reads process.env.PORT.
